 ID_VENDOR_FROM_DATABASE=Intel Corporation
 ID_MODEL_FROM_DATABASE=Example Host Bridge

usb:v046DpC52B*
 ID_VENDOR_FROM_DATABASE=Logitech, Inc.
 ID_MODEL_FROM_DATABASE=USB Optical Mouse
