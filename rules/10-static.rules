# Static device nodes: devtmpfs creates these with kernel defaults
# (usually 0600 root:root); udev's job is to bring them to usable
# permissions at coldplug. Self-written; mirrors the classic static set.
KERNEL=="null",       MODE="0666"
KERNEL=="zero",       MODE="0666"
KERNEL=="full",       MODE="0666"
KERNEL=="random",     MODE="0666"
KERNEL=="urandom",    MODE="0666"
KERNEL=="tty",        GROUP="tty", MODE="0666"
KERNEL=="tty[0-9]*",  GROUP="tty", MODE="0620"
KERNEL=="console",    GROUP="tty", MODE="0600"
KERNEL=="ptmx",       GROUP="tty", MODE="0666"
KERNEL=="ttyS[0-9]*", GROUP="dialout", MODE="0660"
