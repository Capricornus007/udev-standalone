# Default device-node policy for udev-standalone (self-written; no systemd data).
# Groups that do not exist are left unchanged by the installer; uaccess grants
# the logged-in seat user access through elogind/logind ACLs.

# Seat access here is GROUP-based (this daemon has no uaccess ACL backend):
# add the login user to disk/video/input/audio/kvm (usermod -aG). The uaccess
# tags are still recorded in the device DB for libudev clients.
SUBSYSTEM=="block", GROUP="disk", MODE="0660"
KERNEL=="sr*", GROUP="cdrom", MODE="0660", TAG+="uaccess"
KERNEL=="tty*", GROUP="tty", MODE="0620"
KERNEL=="ptmx", GROUP="tty", MODE="0666"
SUBSYSTEM=="input", GROUP="input", MODE="0660", TAG+="uaccess"
KERNEL=="uinput", GROUP="input", MODE="0660", TAG+="uaccess"
KERNEL=="kvm", GROUP="kvm", MODE="0660", TAG+="uaccess"
KERNEL=="fuse", MODE="0666"
SUBSYSTEM=="sound", GROUP="audio", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="drm", GROUP="video", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="video4linux", GROUP="video", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", GROUP="lp", MODE="0664"
