udevhwdbdir = @udevhwdbdir@
udevlibexecdir = @udevlibexecdir@
udevrulesdir = @udevrulesdir@
with_bashcompletiondir = @with_bashcompletiondir@
zshcompletiondir = @zshcompletiondir@
ACLOCAL_AMFLAGS = -I m4 ${ACLOCAL_FLAGS}
AM_CPPFLAGS = $(LIBC_CPPFLAGS) $(PROJECT_FILE_CPPFLAGS) -include \
	$(top_builddir)/config.h -DUDEV_HWDB_BIN=\"$(udevhwdbbin)\" \
	-DUDEV_CONF_DIR=\"$(udevconfdir)\" \
	-DUDEV_ROOT_RUN=\"$(rootrundir)\" \
	-DUDEV_RULES_DIR=\"$(udevrulesdir)\" \
	-DUDEV_LIBEXEC_DIR=\"$(udevlibexecdir)\" \
	-DUDEV_VERSION=\"$(UDEV_VERSION)\" -I $(top_srcdir)/src/shared \
	-I $(top_srcdir)/src/libudev -I $(top_builddir)/src/udev \
	-isystem $(top_srcdir)/src/include/uapi
udevd_SOURCES = \
	udevd.c

udevd_LDADD = \
	libudev-core.la

udevadm_SOURCES = \
	udevadm.c \
	udevadm-info.c \
	udevadm-control.c \
	udevadm-monitor.c \
	udevadm-hwdb.c \
	udevadm-settle.c \
	udevadm-trigger.c \
	udevadm-test.c \
	udevadm-test-builtin.c \
	udevadm-verify.c \
	udevadm-cat.c \
	udevadm-wait.c \
	udevadm-lock.c \
	udevadm-util.c \
	udevadm-util.h

udevadm_LDADD = \
	libudev-core.la

@ENABLE_SYSTEMD_HWDB_TRUE@udev_hwdb_SOURCES = \
@ENABLE_SYSTEMD_HWDB_TRUE@	udev-hwdb.c \
@ENABLE_SYSTEMD_HWDB_TRUE@	udevadm-util.c \
@ENABLE_SYSTEMD_HWDB_TRUE@	udevadm-util.h

@ENABLE_SYSTEMD_HWDB_TRUE@udev_hwdb_LDADD = \
@ENABLE_SYSTEMD_HWDB_TRUE@	libudev-core.la

noinst_LTLIBRARIES = \
        libudev-core.la

libudev_core_la_SOURCES = blockdev-util.c blockdev-util.h \
	reread-partition-table.c reread-partition-table.h udev-dump.c \
	udev-event.c udev-watch.c udev-node.c udev-rules.c \
	udev-rules-check.c udev-rules-check.h hwdb-util.c hwdb-util.h \
	udev-ctrl.c udev-builtin.c udev-builtin-btrfs.c \
	udev-builtin-factory_reset.c udev-builtin-hwdb.c \
	udev-builtin-input_id.c udev-builtin-net_driver.c \
	udev-builtin-net_id.c udev-builtin-net_id-eudev.c \
	netif-naming-scheme.c netif-naming-scheme.h udev-netlink.c \
	udev-netlink.h udev-builtin-path_id.c udev-builtin-usb_id.c \
	$(am__append_2) $(am__append_3) $(am__append_4) \
	udev-builtin-keyboard.c
noinst_HEADERS = \
	udev.h

libudev_core_la_CFLAGS = $(AM_CFLAGS) $(BLKID_CFLAGS) $(am__append_5)
libudev_core_la_LIBADD = $(top_builddir)/src/shared/libudev_shared.la \
	$(top_builddir)/src/libudev/libudev-private.la $(BLKID_LIBS) \
	$(SELINUX_LIBS) $(am__append_6)

#
# Extras
#
dist_udevconf_DATA = \
	udev.conf

sharepkgconfig_DATA = \
	udev.pc

EXTRA_DIST = \
	udev.pc.in


# no longer generated, but left behind in build trees of older versions
CLEANFILES = udev.pc keyboard-keys-from-name.gperf keyboard-keys.txt \
	$(BUILT_SOURCES) keyboard-keys-to-name.h
nodist_libudev_core_la_SOURCES = \
	keyboard-keys-from-name.h


# The silent-rules variable of the gperf rule, like the AM_V_* ones of automake: "GPERF" and the target
# by default and with V=0, the command line with V=1.
AM_V_GPERF = $(AM_V_GPERF_@AM_V@)
AM_V_GPERF_ = $(AM_V_GPERF_@AM_DEFAULT_V@)
AM_V_GPERF_0 = @echo "  GPERF   " $@;
AM_V_GPERF_1 = 
BUILT_SOURCES = \
	$(nodist_libudev_core_la_SOURCES)

all: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign src/udev/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign src/udev/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):
udev.pc: $(top_builddir)/config.status $(srcdir)/udev.pc.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
install-binPROGRAMS: $(bin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-binPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(bindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(bindir)" && $(am__rm_f) $$files

clean-binPROGRAMS:
	$(am__rm_f) $(bin_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(bin_PROGRAMS:$(EXEEXT)=)
install-sbinPROGRAMS: $(sbin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(sbin_PROGRAMS)'; test -n "$(sbindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(sbindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(sbindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(sbindir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(sbindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-sbinPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(sbin_PROGRAMS)'; test -n "$(sbindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(sbindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(sbindir)" && $(am__rm_f) $$files

clean-sbinPROGRAMS:
	$(am__rm_f) $(sbin_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(sbin_PROGRAMS:$(EXEEXT)=)

clean-noinstLTLIBRARIES:
	-$(am__rm_f) $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	echo rm -f $${locs}; \
	$(am__rm_f) $${locs}

libudev-core.la: $(libudev_core_la_OBJECTS) $(libudev_core_la_DEPENDENCIES) $(EXTRA_libudev_core_la_DEPENDENCIES) 
	$(AM_JOBSERVER)$(AM_V_CCLD)$(libudev_core_la_LINK)  $(libudev_core_la_OBJECTS) $(libudev_core_la_LIBADD) $(LIBS)

udev-hwdb$(EXEEXT): $(udev_hwdb_OBJECTS) $(udev_hwdb_DEPENDENCIES) $(EXTRA_udev_hwdb_DEPENDENCIES) 
	$(AM_JOBSERVER)@rm -f udev-hwdb$(EXEEXT)
	$(AM_JOBSERVER)$(AM_V_CCLD)$(LINK) $(udev_hwdb_OBJECTS) $(udev_hwdb_LDADD) $(LIBS)

udevadm$(EXEEXT): $(udevadm_OBJECTS) $(udevadm_DEPENDENCIES) $(EXTRA_udevadm_DEPENDENCIES) 
	$(AM_JOBSERVER)@rm -f udevadm$(EXEEXT)
	$(AM_JOBSERVER)$(AM_V_CCLD)$(LINK) $(udevadm_OBJECTS) $(udevadm_LDADD) $(LIBS)

udevd$(EXEEXT): $(udevd_OBJECTS) $(udevd_DEPENDENCIES) $(EXTRA_udevd_DEPENDENCIES) 
	$(AM_JOBSERVER)@rm -f udevd$(EXEEXT)
	$(AM_JOBSERVER)$(AM_V_CCLD)$(LINK) $(udevd_OBJECTS) $(udevd_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

